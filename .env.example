# Copy this file to .env.local for local development.
# Add the same keys in Vercel Project Settings > Environment Variables before production deployment.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/majormate?retryWrites=true&w=majority"
AUTH_SECRET="generate-with-npx-auth-secret-or-openssl-rand-base64-32"
# Optional local workaround when Node's default DNS rejects MongoDB SRV queries.
# MONGODB_DNS_SERVERS="1.1.1.1,8.8.8.8"

# Optional: public data portal key for the K-Startup announcements API (decoded key).
K_STARTUP_SERVICE_KEY=""

# Optional: public data portal decoded key approved for the MSIT announcements API.
MSIT_SERVICE_KEY=""

# Optional: service key issued by Bizinfo for its support-announcements API.
BIZINFO_API_KEY=""
